POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow-local-password

# Credenciais usadas somente pelo bootstrap do servidor MinIO.
MINIO_ROOT_USER=docflow-root
MINIO_ROOT_PASSWORD=docflow-root-password

# Credenciais da aplicação; não são inferidas automaticamente das credenciais root.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=docflow-app
MINIO_SECRET_KEY=docflow-app-password
MINIO_STAGING_BUCKET=docflow-staging
MINIO_BUCKET=docflow-documents
MINIO_CONNECT_TIMEOUT=PT3S
MINIO_READ_TIMEOUT=PT3S
MINIO_WRITE_TIMEOUT=PT3S

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=docflow
RABBITMQ_PASSWORD=docflow-rabbit-password
RABBITMQ_MANAGEMENT_PORT=15672

BOOTSTRAP_MAX_ATTEMPTS=60
BOOTSTRAP_RETRY_DELAY_SECONDS=2

DOCFLOW_MESSAGING_ENABLED=true
DOCFLOW_RECONCILIATION_ENABLED=true
DOCFLOW_RECONCILIATION_MAX_ATTEMPTS=5
DOCFLOW_RECONCILIATION_BACKOFF=PT1M,PT5M,PT15M,PT30M,PT60M
DOCFLOW_RECONCILIATION_SCHEDULE_INTERVAL=PT1M
DOCFLOW_PROCESSING_TIMEOUT=PT3S
DOCFLOW_NOTIFICATION_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:4200
DOCFLOW_LOG_RETENTION=PT3H
DOCFLOW_LOG_RETENTION_SCHEDULE_INTERVAL=PT1M
DOCFLOW_LOGS_MAX_PAGE_SIZE=100

# Notificações de e-mail: o access key permanece vazio até uma configuração explícita.
# Nunca copie uma chave real ou um destinatário real para este arquivo versionado.
WEB3FORMS_ACCESS_KEY=
DOCFLOW_NOTIFICATION_DEFAULT_EMAIL=
WEB3FORMS_API_URL=https://api.web3forms.com/submit
