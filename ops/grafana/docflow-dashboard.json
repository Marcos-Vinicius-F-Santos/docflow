{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "DocFlow - Operação",
  "uid": "docflow-operacao",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Documentos em processamento",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "docflow_documents_state{state=\"PROCESSING\"}", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "RESULT_UNKNOWN",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "docflow_documents_result_unknown", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Uploads por resultado",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (outcome) (rate(docflow_document_uploads_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Processamento por resultado",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "sum by (outcome) (rate(docflow_document_processing_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "P95 HTTP",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"dockflow\"}[5m])))", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Storage por operação e resultado",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "sum by (operation, outcome) (rate(docflow_storage_operations_total[5m]))", "legendFormat": "{{operation}} / {{outcome}}", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RabbitMQ por fila e resultado",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "sum by (queue, outcome) (rate(docflow_rabbit_messages_total[5m]))", "legendFormat": "{{queue}} / {{outcome}}", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retry por resultado",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "sum by (outcome) (rate(docflow_document_retries_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }]
    }
  ]
}
